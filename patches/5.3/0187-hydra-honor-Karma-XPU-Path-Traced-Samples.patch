From fba39e9ed8f81c1136663ee6cc114269024df420 Mon Sep 17 00:00:00 2001
From: BDE <dev@bde.run>
Date: Mon, 23 Nov 2026 12:32:10 +0100
Subject: [PATCH] hydra: honor Karma XPU Path Traced Samples with Cycles
 overrides

---
 src/hydra/file_reader.cpp     |  4 ++-
 src/hydra/render_delegate.cpp | 57 +++++++++++++++++++++++++++++++----
 2 files changed, 54 insertions(+), 7 deletions(-)

diff --git a/src/hydra/file_reader.cpp b/src/hydra/file_reader.cpp
index 7c0d491..01f3fe3 100644
--- a/src/hydra/file_reader.cpp
+++ b/src/hydra/file_reader.cpp
@@ -134,7 +134,9 @@ bool HdCyclesFileReader::read(Session *session,
   if (render_settings) {
     for (const UsdAttribute &attribute : render_settings.GetPrim().GetAttributes()) {
       const std::string name = attribute.GetName().GetString();
-      if (name.compare(0, 7, "cycles:") == 0) {
+      if (name.compare(0, 7, "cycles:") == 0 || name == "karma:global:engine" ||
+          name == "karma:global:pathtracedsamples")
+      {
         VtValue value;
         if (attribute.Get(&value, time)) {
           settings_map[attribute.GetName()] = value;
diff --git a/src/hydra/render_delegate.cpp b/src/hydra/render_delegate.cpp
index bbbe8d1..ac782ce 100644
--- a/src/hydra/render_delegate.cpp
+++ b/src/hydra/render_delegate.cpp
@@ -62,6 +62,31 @@ TF_DEFINE_PRIVATE_TOKENS(_tokens,
 
 namespace {
 
+const TfToken kKarmaEngine("karma:global:engine");
+const TfToken kKarmaPathTracedSamples("karma:global:pathtracedsamples");
+
+/* The constructors can start from either Hydra's default or a standalone
+ * session supplied by the caller. Keep that fallback when a live stage clears
+ * both authored sample settings. This key is private to the delegate. */
+const TfToken kInitialSampleLimit("_cyclesInitialSampleLimit");
+
+int ReadSampleLimit(const HdRenderSettingsMap &settings, const TfToken &key)
+{
+  const auto it = settings.find(key);
+  return it == settings.end() ? 0 : VtValue::Cast<int>(it->second).GetWithDefault(0);
+}
+
+bool IsKarmaXpu(const HdRenderSettingsMap &settings)
+{
+  const auto it = settings.find(kKarmaEngine);
+  if (it == settings.end()) {
+    return false;
+  }
+  const VtValue &engine = it->second;
+  return engine.IsHolding<TfToken>() ? engine.UncheckedGet<TfToken>() == TfToken("xpu") :
+                                      engine.GetWithDefault(std::string()) == "xpu";
+}
+
 const TfTokenVector kSupportedRPrimTypes = {
     HdPrimTypeTokens->basisCurves,
     HdPrimTypeTokens->mesh,
@@ -205,6 +230,7 @@ HdCyclesDelegate::HdCyclesDelegate(const HdRenderSettingsMap &settingsMap,
   _renderParam = session_ ? std::make_unique<HdCyclesSession>(session_, keep_nodes) :
                             std::make_unique<HdCyclesSession>(GetSessionParams(settingsMap));
 
+  _settingsMap[kInitialSampleLimit] = VtValue(_renderParam->session->params.samples);
   for (const auto &setting : settingsMap) {
     // Skip over the settings known to be used for initialization only
     if (setting.first == HdCyclesRenderSettingsTokens->device ||
@@ -459,6 +485,7 @@ VtDictionary HdCyclesDelegate::GetRenderStats() const
                          {"rendererVersion", VtValue(GfVec3i(0, 0, 0))},
                          {"percentDone", VtValue(floor_to_int(fractionDone * 100))},
                          {"fractionDone", VtValue(fractionDone)},
+                         {"cyclesSampleLimit", VtValue(_renderParam->session->params.samples)},
                          {"loadClockTime", VtValue(totalTime - renderTime)},
                          {"peakMemory", VtValue(stats.mem_peak)},
                          {"totalClockTime", VtValue(totalTime)},
@@ -592,8 +619,12 @@ HdRenderSettingDescriptorList HdCyclesDelegate::GetRenderSettingDescriptors() co
   descriptors.push_back({
       "Sample Count",
       HdCyclesRenderSettingsTokens->samples,
-      VtValue(1024),
+      /* Zero marks an unset native override when a Hydra host supplies
+       * descriptor defaults for attributes it could not find. */
+      VtValue(0),
   });
+  descriptors.push_back({"Karma Engine", kKarmaEngine, VtValue(std::string())});
+  descriptors.push_back({"Karma Path Traced Samples", kKarmaPathTracedSamples, VtValue(0)});
   descriptors.push_back({
       "Sample Offset",
       HdCyclesRenderSettingsTokens->sampleOffset,
@@ -668,11 +699,22 @@ void HdCyclesDelegate::SetRenderSetting(const PXR_NS::TfToken &key, const PXR_NS
     session->set_time_limit(
         VtValue::Cast<double>(value).GetWithDefault(session->params.time_limit));
   }
-  else if (key == HdCyclesRenderSettingsTokens->samples) {
-    static const int max_samples = Integrator::MAX_SAMPLES;
-    int samples = VtValue::Cast<int>(value).GetWithDefault(session->params.samples);
-    samples = std::min(std::max(1, samples), max_samples);
-    session->set_samples(samples);
+  else if (key == HdCyclesRenderSettingsTokens->samples || key == kKarmaPathTracedSamples ||
+           key == kKarmaEngine)
+  {
+    _settingsMap[key] = value;
+    /* Native Cycles settings win independently of Hydra's update order.
+     * The same node authors pathtracedsamples even in CPU mode, where it
+     * does not represent the XPU per-pixel limit. */
+    int samples = ReadSampleLimit(_settingsMap, HdCyclesRenderSettingsTokens->samples);
+    if (samples == 0 && IsKarmaXpu(_settingsMap)) {
+      samples = ReadSampleLimit(_settingsMap, kKarmaPathTracedSamples);
+    }
+    if (samples == 0) {
+      samples = ReadSampleLimit(_settingsMap, kInitialSampleLimit);
+    }
+    constexpr int max_samples = Integrator::MAX_SAMPLES;
+    session->set_samples(std::clamp(samples, 1, max_samples));
   }
   else if (key == HdCyclesRenderSettingsTokens->dicingRate) {
     const float rate = VtValue::Cast<float>(value).GetWithDefault(_renderParam->GetDicingRate());
@@ -840,6 +882,9 @@ VtValue HdCyclesDelegate::GetRenderSetting(const TfToken &key) const
   Scene *const scene = _renderParam->session->scene.get();
   Session *const session = _renderParam->session;
 
+  if (key == kKarmaPathTracedSamples || key == kKarmaEngine) {
+    return HdRenderDelegate::GetRenderSetting(key);
+  }
   if (key == HdCyclesRenderSettingsTokens->stageMetersPerUnit) {
     return VtValue(_renderParam->GetStageMetersPerUnit());
   }

 #include <pxr/base/plug/registry.h>
 #include <pxr/imaging/hd/flatteningSceneIndex.h>
@@ -41,4 +44,72 @@
 HDCYCLES_NAMESPACE_OPEN_SCOPE

+namespace {
+
+void InheritKarmaBeautyDenoising(const UsdRenderSettings &settings,
+                                const UsdTimeCode &time,
+                                HdRenderSettingsMap &values)
+{
+  static const TfToken useDenoise("cycles:integrator:use_denoise");
+  if (values.find(useDenoise) != values.end()) {
+    return;
+  }
+
+  static const TfToken imageFilter("karma:global:imagefilter");
+  std::string filterSpec;
+  if (!settings.GetPrim().GetAttribute(imageFilter).Get(&filterSpec, time)) {
+    return;
+  }
+  const JsValue filters = JsParseString(filterSpec);
+  if (!filters.IsArray()) {
+    return;
+  }
+  for (const JsValue &filter : filters.GetJsArray()) {
+    if (!filter.IsArray()) {
+      continue;
+    }
+    const JsArray &entry = filter.GetJsArray();
+    if (entry.size() != 2 || entry[0] != JsValue("denoise") || !entry[1].IsObject()) {
+      continue;
+    }
+    const JsObject &options = entry[1].GetJsObject();
+    const auto engine = options.find("engine");
+    const auto aovs = options.find("aovs");
+    if (engine == options.end() || engine->second != JsValue("oidn") ||
+        aovs == options.end() || !aovs->second.IsArray())
+    {
+      continue;
+    }
+
+    /* The standalone output is beauty. Karma can filter its AOVs independently. */
+    bool beauty = false;
+    for (const JsValue &aov : aovs->second.GetJsArray()) {
+      beauty |= aov == JsValue("C");
+    }
+    if (!beauty) {
+      continue;
+    }
+    const auto getBool = [&options](const char *name, const bool fallback) {
+      const auto it = options.find(name);
+      return it != options.end() && it->second.IsBool() ? it->second.GetBool() : fallback;
+    };
+    int guides = DENOISER_PASS_NONE;
+    if (getBool("use_albedo_input", true)) {
+      guides |= DENOISER_PASS_ALBEDO;
+    }
+    if (getBool("use_n_input", true)) {
+      guides |= DENOISER_PASS_NORMAL;
+    }
+    values.insert({useDenoise, VtValue(true)});
+    values.insert({TfToken("cycles:integrator:denoiser_type"),
+                   VtValue(std::string("openimagedenoise"))});
+    values.insert({TfToken("cycles:integrator:denoiser_passes"), VtValue(guides)});
+    values.insert({TfToken("cycles:integrator:denoise_use_gpu"),
+                   VtValue(!getBool("forcecpu", false))});
+    return;
+  }
+}
+
+}  // namespace
+
 /* Dummy task whose only purpose is to provide render tag tokens to the render index. */
 class DummyHdTask : public HdTask {
@@ -151,4 +222,5 @@ bool HdCyclesFileReader::read(Session *session,
       }
     }
+    InheritKarmaBeautyDenoising(render_settings, time, settings_map);
   }


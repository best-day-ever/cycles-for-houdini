diff --git a/src/app/image_info.cpp b/src/app/image_info.cpp
new file mode 100644
index 00000000..a9183e50
--- /dev/null
+++ b/src/app/image_info.cpp
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include <OpenImageIO/imagebuf.h>
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <limits>
+
+int main(int argc, char **argv)
+{
+  if (argc != 2) {
+    fprintf(stderr, "Usage: cycles_image_info image.exr\n");
+    return 2;
+  }
+  OIIO::ImageBuf image(argv[1]);
+  if (!image.read(0, 0, true, OIIO::TypeDesc::FLOAT)) {
+    fprintf(stderr, "%s\n", image.geterror().c_str());
+    return 1;
+  }
+  const OIIO::ImageSpec &spec = image.spec();
+  double minimum = std::numeric_limits<double>::infinity();
+  double maximum = -minimum;
+  unsigned long long nonfinite = 0;
+  for (OIIO::ImageBuf::ConstIterator<float> pixel(image); !pixel.done(); ++pixel) {
+    for (int channel = 0; channel < spec.nchannels; ++channel) {
+      const double value = pixel[channel];
+      if (!std::isfinite(value)) {
+        ++nonfinite;
+      }
+      else {
+        minimum = std::min(minimum, value);
+        maximum = std::max(maximum, value);
+      }
+    }
+  }
+  if (!std::isfinite(minimum) || !std::isfinite(maximum)) {
+    return 1;
+  }
+  printf("{\"width\":%d,\"height\":%d,\"channels\":%d,\"nonfinite\":%llu,"
+         "\"min\":%.9g,\"max\":%.9g}\n",
+         spec.width, spec.height, spec.nchannels, nonfinite, minimum, maximum);
+  return nonfinite ? 1 : 0;
+}
